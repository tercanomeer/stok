{
  "name": "stokk",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --fix",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "test:e2e": "playwright test --pass-with-no-tests",
    "clean": "turbo run clean && rm -rf node_modules .turbo",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,yaml,yml,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,yaml,yml,css}\"",
    "db:generate": "pnpm --filter @stokk/db generate",
    "db:migrate": "pnpm --filter @stokk/db migrate",
    "db:reset": "pnpm --filter @stokk/db reset",
    "db:seed": "pnpm --filter @stokk/db seed",
    "db:studio": "pnpm --filter @stokk/db studio",
    "db:validate": "pnpm --filter @stokk/db validate",
    "prepare": "husky",
    "test:e2e:install": "playwright install --with-deps chromium"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@stokk/config": "workspace:*",
    "eslint": "catalog:",
    "husky": "9.1.7",
    "lint-staged": "17.4.1",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "turbo": "2.10.12",
    "typescript": "catalog:"
  },
  "lint-staged": {
    "*.{ts,tsx,mts,cts}": [
      "prettier --write",
      "eslint --fix --no-warn-ignored --max-warnings 0"
    ],
    "*.{js,jsx,mjs,cjs}": [
      "prettier --write",
      "eslint --fix --no-warn-ignored --max-warnings 0"
    ],
    "*.{json,yaml,yml,css,md}": [
      "prettier --write"
    ]
  }
}
