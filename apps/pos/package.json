{
  "name": "@stokk/pos",
  "version": "0.0.0",
  "private": true,
  "description": "Stokk kasa uygulaması",
  "author": "Stokk",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "dev:electron": "pnpm build:main && VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "build": "tsc -p tsconfig.main.json && vite build",
    "build:main": "tsc -p tsconfig.main.json",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json --noEmit && tsc -p tsconfig.test.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "package": "pnpm build && electron-builder",
    "clean": "rm -rf dist dist-electron release .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@stokk/pos-core": "workspace:*",
    "@stokk/types": "workspace:*",
    "better-sqlite3": "catalog:",
    "electron-updater": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@stokk/config": "workspace:*",
    "@stokk/ui": "workspace:*",
    "@tailwindcss/postcss": "catalog:",
    "@types/better-sqlite3": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "electron": "catalog:",
    "electron-builder": "catalog:",
    "eslint": "catalog:",
    "lucide-react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
