{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Stokk Library (saf TS, CommonJS çıktı, DOM yok)",
  "extends": "./base.json",
  "compilerOptions": {
    // CommonJS: tüketicisi hem NestJS (CJS) hem bundler (Vite/Next).
    // Node16 çözümü paketin "type" alanına bakar; package.json'da "type" yok,
    // dolayısıyla CJS modunda derlenir ve uzantısız relative import serbest kalır.
    "module": "Node16",
    "moduleResolution": "node16",
    "verbatimModuleSyntax": false,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noEmit": false
  }
}
