# ---------------------------------------------------------------------------
# Stokk — ortam değişkenleri şablonu
# Kopyala: cp .env.example .env
# Env şeması Zod ile doğrulanır; eksik veya biçimsiz değişkenle uygulama açılmaz.
# ---------------------------------------------------------------------------

NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:3001
API_PORT=3001

# Virgülle ayrılmış whitelist. Buranın dışındaki origin'e CORS izni verilmez.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Veri ---------------------------------------------------------------
DATABASE_URL=postgresql://stokk:stokk@localhost:5432/stokk?schema=public
# Uygulamanın runtime bağlantısı. stokk_app tablo sahibi DEĞİL, dolayısıyla
# row-level security politikalarına tabidir. Migration/seed DATABASE_URL kullanır.
APP_DATABASE_URL=postgresql://stokk_app:en-az-12-karakter-rastgele@localhost:5432/stokk?schema=public
REDIS_URL=redis://localhost:6379

# --- Kimlik -------------------------------------------------------------
# Production'da 64+ karakter rastgele: openssl rand -hex 32
JWT_SECRET=dev-only-degistir-production-da-64-karakter-rastgele-olmali-aaaa
JWT_REFRESH_SECRET=dev-only-degistir-production-da-64-karakter-rastgele-olmali-bbbb
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- Dosya depolama (dev: MinIO, prod: S3) ------------------------------
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=stokk
S3_SECRET=stokk12345
S3_BUCKET=stokk
S3_FORCE_PATH_STYLE=true

# --- Bildirim -----------------------------------------------------------
# log = dev'de konsola düşer, gerçek gönderim yapılmaz
SMS_PROVIDER=log
MAIL_PROVIDER=log
MAIL_FROM=noreply@stokk.local
SMTP_URL=

# --- Yasal & ödeme adapter'ları (Faz 7 / Faz 15) ------------------------
EINVOICE_PROVIDER=mock
OKC_PROVIDER=mock
PAYMENT_PROVIDER=mock

# --- İzleme -------------------------------------------------------------
SENTRY_DSN=
LOG_LEVEL=debug
