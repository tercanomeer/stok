{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": ["tsconfig.base.json", "pnpm-lock.yaml", ".env.example"],
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "dist-electron/**", ".next/**", "!.next/cache/**", "src/generated/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "lint": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test:watch": {
      "cache": false,
      "persistent": true
    },
    "test:e2e": {
      "dependsOn": ["^build"],
      "cache": false,
      "outputs": ["playwright-report/**", "test-results/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    },
    "@stokk/db#generate": {
      "inputs": ["prisma/**", "prisma.config.ts"],
      "outputs": ["src/generated/**"],
      "env": ["DATABASE_URL"]
    },
    "@stokk/db#build": {
      "dependsOn": ["@stokk/db#generate"],
      "outputs": ["dist/**", "src/generated/**"],
      "env": ["DATABASE_URL"]
    },
    "@stokk/api#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "env": ["DATABASE_URL", "REDIS_URL"]
    },
    "@stokk/web#build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**"],
      "env": ["NEXT_PUBLIC_*", "API_URL"]
    },
    "@stokk/pos-core#test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "@stokk/db#typecheck": {
      "dependsOn": ["@stokk/db#generate", "^build"],
      "outputs": []
    },
    "@stokk/db#lint": {
      "dependsOn": ["@stokk/db#generate", "^build"],
      "outputs": []
    },
    "@stokk/db#test": {
      "dependsOn": ["@stokk/db#generate", "^build"],
      "outputs": ["coverage/**"]
    },
    "@stokk/db#seed": {
      "dependsOn": ["^build", "@stokk/db#generate"],
      "cache": false
    },
    "@stokk/db#migrate": {
      "dependsOn": ["@stokk/db#generate"],
      "cache": false
    },
    "@stokk/db#reset": {
      "dependsOn": ["^build", "@stokk/db#generate"],
      "cache": false
    },
    "@stokk/db#studio": {
      "dependsOn": ["@stokk/db#generate"],
      "cache": false,
      "persistent": true
    },
    "@stokk/db#validate": {
      "dependsOn": [],
      "cache": false
    },
    "@stokk/db#setup-app-role": {
      "dependsOn": ["^build", "@stokk/db#generate"],
      "cache": false
    }
  }
}
