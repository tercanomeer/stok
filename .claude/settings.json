{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm install)",
      "Bash(pnpm install --frozen-lockfile)",
      "Bash(pnpm lint)",
      "Bash(pnpm lint:fix)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm test)",
      "Bash(pnpm test:watch)",
      "Bash(pnpm test:e2e)",
      "Bash(pnpm build)",
      "Bash(pnpm format)",
      "Bash(pnpm format:check)",
      "Bash(pnpm db:generate)",
      "Bash(pnpm db:validate)",
      "Bash(pnpm --filter *)",
      "Bash(pnpm exec eslint *)",
      "Bash(pnpm exec tsc *)",
      "Bash(pnpm exec vitest *)",
      "Bash(pnpm exec prisma generate)",
      "Bash(pnpm exec prisma validate)",
      "Bash(pnpm exec playwright test *)",
      "Bash(pnpm approve-builds *)",
      "Bash(turbo run *)",
      "Bash(npx tsc *)",
      "Bash(npm view *)",
      "Bash(docker compose ps *)",
      "Bash(docker compose up -d)",
      "Bash(docker compose down)",
      "Bash(docker compose logs *)",
      "Bash(docker compose config *)",
      "Bash(docker compose pull)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git add *)",
      "Bash(git branch *)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)",
      "Bash(docker system prune *)",
      "Bash(docker volume rm *)",
      "Bash(pnpm publish *)",
      "Read(./.env)"
    ]
  }
}
